
{
  "name": "jita",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && echo \"Commit: $(git rev-parse HEAD)\nBranch: $(git rev-parse --abbrev-ref HEAD)\nBuilt: $(date)\" > dist/VERSION",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "preview": "vite preview"
  },
