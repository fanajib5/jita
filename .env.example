# ── Docker Compose / Coolify (isi di UI Coolify: Environment Variables) ──
MYSQL_ROOT_PASSWORD=ganti_password_root_mysql
MYSQL_DATABASE=jitadb
MYSQL_USER=jita
MYSQL_PASSWORD=ganti_password_mysql
SESSION_SECRET=string_acak_panjang_untuk_cookie
# Set false jika masih testing via direct IP (HTTP) tanpa SSL/HTTPS
COOKIE_SECURE=false
# Set true jika ingin melihat request logging pino di logs backend
LOG_HTTP=true
# Domain publik frontend di Coolify
ALLOWED_ORIGINS=https://jita.domainkamu.com
# '/' saat deploy di subdomain Coolify; '/jita/' jika meniru pola cPanel
VITE_BASE_PATH=/

# ── Frontend (build-time) ──
# Kosong = same-origin lewat proxy /api di nginx.conf
VITE_API_BASE=

# ── Backend opsional: notifikasi email (SMTP) & webhook ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=JITA <noreply@domainkamu.com>
# WEBHOOK_URL=
# WEBHOOK_SECRET=
