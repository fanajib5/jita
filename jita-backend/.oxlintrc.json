{
  "$schema": "./node_modules/oxlint/configuration.schema.json",
  "plugins": ["typescript", "import", "node", "jest"],
  "rules": {
    "import/no-cycle": "error",
    "import/no-default-export": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    "*.config.ts",
    "*.test.ts",
    "*.spec.ts",
    "*.d.ts"
  ]
}
