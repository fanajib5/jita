# --- Environment ---
NODE_ENV=production

# --- Required (existing) ---
DB_HOST=localhost
DB_USER=oralunas_jitaadmin
DB_PASSWORD=your_db_password
DB_NAME=oralunas_jitadb
SESSION_SECRET=change_me
# Set false jika deploy/testing via direct IP (HTTP) tanpa HTTPS; default mengikuti NODE_ENV === 'production'
COOKIE_SECURE=false
# Set true jika ingin melihat log request HTTP (Pino) saat production
LOG_HTTP=false

# --- Optional: SMTP (Pillar 4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JITA <noreply@jita.id>

# --- Optional: Webhook API gateway (Pillar 4) ---
# If WEBHOOK_URL is empty, webhook channel is skipped (only email is used).
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Pusat Es SSO Integration ---
ES_SSO_BASE_URL=https://pusates.kampusmu.id/wp-json/ice-sso/v1
ES_SSO_ISSUER=https://pusates.kampusmu.id/id
ES_SSO_AUDIENCE=ijete

